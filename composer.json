{
    "name": "vidarl/ibexa-bulk-operation-guard",
    "description": "Restricts Ibexa DXP bulk operation URIs to REST resources (backport of IBX-13044)",
    "type": "ibexa-bundle",
    "license": "GPL-2.0-only",
    "homepage": "https://github.com/vidarl/ibexa-bulk-operation-guard",
    "autoload": {
        "psr-4": {
            "VidarL\\IbexaBulkOperationGuardBundle\\": "src/bundle/"
        }
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ibexa/admin-ui": "^4.6 || ^5.0",
        "ibexa/rest": "^4.6 || ^5.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "ibexa/admin-ui": ">=4.6.33 <5.0 || >=5.0.11"
    }
}
